# ─────────────────────────────────────────────────────────────
# NovaPanel — configuration du backend
# Copiez ce fichier en `.env` (jamais commité) et complétez-le.
# Sans configuration, chaque source passe en mode démo (données fictives).
# ─────────────────────────────────────────────────────────────

# Adresse d'écoute de l'API (laisser 127.0.0.1 tant que l'auth n'existe pas)
NOVA_BIND_HOST=127.0.0.1
NOVA_BIND_PORT=8000
# Intervalle de collecte des métriques (secondes)
NOVA_POLL_INTERVAL=10
# Forcer le mode démo même si des identifiants sont présents
NOVA_DEMO=false

# ── Proxmox VE (jeton API, lecture seule : rôle PVEAuditor sur "/") ──
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
# Utilisateur propriétaire du jeton, ex. root@pam ou novapanel@pve
PROXMOX_USER=novapanel@pve
# Nom du jeton (Token ID) — sans le préfixe utilisateur
PROXMOX_TOKEN_NAME=novapanel
# Secret du jeton (affiché une seule fois par Proxmox)
PROXMOX_TOKEN_SECRET=
# Certificat auto-signé par défaut sur Proxmox → false. Mettre true avec un vrai certificat.
PROXMOX_VERIFY_SSL=false

# ── Serveur Docker distant via SSH ──
# Alias défini dans ~/.ssh/config (HostName, User, IdentityFile) — voir README.
# Exemple : DOCKER_SSH_HOST=nova-oracle
DOCKER_SSH_HOST=
# Nom affiché dans le panneau
DOCKER_DISPLAY_NAME=oracle-docker
